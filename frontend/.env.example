# ===================================================================
# UNIVERSAL MEDIA STUDIO - FRONTEND ENVIRONMENT EXAMPLE
# Copy this file to .env or .env.local or paste in Coolify Environment Variables
# ===================================================================

# Public Backend URL for browser requests & Next.js proxy rewrites
NEXT_PUBLIC_BACKEND_URL=https://your-backend-domain.com

# Server-Side Backend URL (Useful if Next.js and backend communicate over internal Docker network)
BACKEND_URL=https://your-backend-domain.com

# Port configuration
PORT=3000

# Disable telemetry
NEXT_TELEMETRY_DISABLED=1
