# ===================================================================
# UNIVERSAL MEDIA STUDIO - FRONTEND ENVIRONMENT CONFIGURATION
# ===================================================================

# In production on Coolify, set this to your deployed backend URL.
# Examples:
#   NEXT_PUBLIC_BACKEND_URL=https://api.yourdomain.com
#   NEXT_PUBLIC_BACKEND_URL=https://backend-production-xyz.coolify.yourdomain.com
#
# If running locally or on the same Docker network:
#   NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:5000
#   BACKEND_URL=http://backend:5000

NEXT_PUBLIC_BACKEND_URL=http://46.202.167.245:5000
BACKEND_URL=http://46.202.167.245:5000

# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:5000
# BACKEND_URL=http://127.0.0.1:5000

# Next.js Port (Default 3000)
PORT=3000

# Next.js Telemetry (Set to 1 to disable anonymous tracking during Docker builds)
NEXT_TELEMETRY_DISABLED=1
